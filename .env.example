# Supabase — get from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Provider — per RT (disimpan di rt_ai_settings, fallback ke env)
# Pilihan provider: openrouter | openai | anthropic | mock
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Telegram Bot — Phase 7
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_WEBHOOK_SECRET=your-random-secret-for-webhook-verification
NEXT_PUBLIC_APP_URL=http://localhost:3000
