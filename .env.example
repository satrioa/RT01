# Supabase — get from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (dipakai untuk link Telegram & redirect)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron laporan bulanan (opsional; jika diisi, endpoint /api/cron/monthly-reports wajib memakai secret)
CRON_SECRET=your-random-cron-secret

# AI Provider — per RT (disimpan di rt_ai_settings, fallback ke env)
# Pilihan provider: openrouter | openai | anthropic | gemini | mock
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_WEBHOOK_SECRET=your-random-secret-for-webhook-verification
